# Copy this file to .ril-test.env (git-ignored) and fill it in. run-tests.py reads it,
# so `python run-tests.py` and `python run-tests.py --database` need no other setup.
# A variable already set in the environment wins over this file.
#
# The server under test, and a user that can CREATE and DROP databases and users on it.
# The tests only touch throwaway databases named ril_test_xxxxxxxx; the application
# database is never used. From inside the Cat container the host is reached as
# host.docker.internal.
RIL_TEST_DB_HOST=host.docker.internal
RIL_TEST_DB_PORT=3306
RIL_TEST_DB_USER=
RIL_TEST_DB_PASSWORD=
# true to require TLS; false for a development server without it
RIL_TEST_DB_REQUIRE_SSL=false
# yes or no: whether the server offers TLS. Leave empty to skip the TLS test.
RIL_TEST_DB_TLS=
